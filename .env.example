# Copia este fichero a .env.local y rellena los valores.
# .env.local está en .gitignore: las claves nunca se versionan.

# El dominio del sitio, sin barra final. Es de lo que cuelgan las canónicas,
# el sitemap y las URL de Open Graph.
#
# Si no se rellena, en Vercel se cae a la URL del despliegue y las páginas
# salen marcadas noindex: es a propósito, para que un preview no compita con
# el sitio de verdad. En producción TIENE que estar puesta.
NEXT_PUBLIC_SITE_URL=https://tempscat.cat

# AEMET OpenData. Gratuita e inmediata, caduca a los 90 días:
# https://opendata.aemet.es/centrodedescargas/altaUsuario
AEMET_API_KEY=

# Opcional. Sube el límite de throughput del portal de datos abiertos.
SOCRATA_APP_TOKEN=

# Opcional. Solo para las teselas del mapa.
OPENWEATHER_API_KEY=

# ── L'emmagatzematge de dades vives ─────────────────────────────────────────
#
# En producció no hi ha disc: els workers pugen les instantànies a un magatzem
# d'objectes i l'aplicació les llegeix d'allà. En local no cal cap de les dues:
# sense elles tot funciona contra `data/cache/`, igual que sempre.
#
# Base pública del magatzem, sense barra final. La llegeix l'APLICACIÓ.
# A Vercel: Storage -> el teu Blob store -> l'origen de qualsevol fitxer.
BLOB_BASE_URL=

# Testimoni d'escriptura. El fan servir els WORKERS, mai l'aplicació.
# A Vercel el crea sol quan connectes el Blob store al projecte.
BLOB_READ_WRITE_TOKEN=
