# Copia este fichero a .env.local y rellena los valores.
# .env.local está en .gitignore: las claves nunca se versionan.

# El dominio del sitio, sin barra final. Es de lo que cuelgan las canónicas,
# el sitemap, las URL de Open Graph y los identificadores de los feeds.
#
# Sin prefijo NEXT_PUBLIC_ a propósito: solo la lee el servidor, así que no
# tiene por qué viajar al navegador.
#
# Si no se rellena, en Vercel se cae a la URL del despliegue y las páginas
# salen marcadas noindex: es a propósito, para que un preview no compita con
# el sitio de verdad. En producción TIENE que estar puesta.
SITE_URL=https://tempscat.cat

# AEMET OpenData. Gratuita e inmediata, caduca a los 90 días:
# https://opendata.aemet.es/centrodedescargas/altaUsuario
AEMET_API_KEY=

# Opcional. Sube el límite de throughput del portal de datos abiertos.
SOCRATA_APP_TOKEN=

# Opcional. Solo para las teselas del mapa.
OPENWEATHER_API_KEY=

# ── L'emmagatzematge de dades vives ──────────────────────────────
#
# En producció no hi ha disc: els workers pugen les instantànies a un magatzem
# d'objectes i l'aplicació les llegeix d'allà. En local no cal cap de les
# quatre: sense elles tot funciona contra `data/cache/`, igual que sempre.
#
# És Cloudflare R2 i no el magatzem de Vercel per una raó sola: **R2 no
# factura la sortida de dades**. Aquest lloc existeix per servir dades
# públiques, i amb el magatzem anterior un sol rastreig del sitemap es menjava
# més d'un mes de quota. Se la va menjar, l'1 de setembre de 2026.

# Base pública del magatzem, sense barra final. La llegeix l'APLICACIÓ.
# És el domini propi que R2 serveix: R2 -> el cub -> Settings -> Public access.
DATA_BASE_URL=https://dades.tempscat.cat

# Credencials d'escriptura. Les fan servir els WORKERS, mai l'aplicació.
# R2 -> Manage API tokens -> Create token, amb permis d'Object Read & Write
# nomes sobre aquest cub. El secret nomes es veu un cop.
R2_ACCOUNT_ID=
R2_BUCKET=tempscat-dades
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
